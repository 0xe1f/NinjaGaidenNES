# NinjaGaiden (NES, MMC1, 256 KiB) disassembly build.
# Generated by tools/gen-makefile.py — do not edit PRG_BINS / CHR_BINS by hand.
#
#   make            assemble NinjaGaiden.asm -> NinjaGaiden.nes
#   make verify     SHA-1 check against NinjaGaiden.sha1
#   make banks      split reference/gaiden.nes into prg/ and chr/ bins
#   make tools      build ca65/ld65 into tools/ (cc65 V2.19)
#   make clean      remove the assembled ROM and object file
#
# Prerequisite: tools/ca65 and tools/ld65 (make tools).
# While banks are still INCBIN, run `make banks` once. Later verifies do not
# need reference/gaiden.nes if the bins are already on disk.

SRC      := NinjaGaiden.asm
CFG      := NinjaGaiden.cfg
OUT      := NinjaGaiden.nes
SHA1FILE := NinjaGaiden.sha1
CA65     ?= tools/ca65
LD65     ?= tools/ld65
ROM      ?= reference/gaiden.nes
SHA1SUM  ?= $(shell command -v sha1sum 2>/dev/null || echo "shasum -a 1")

PRG_BINS :=
CHR_BINS := $(patsubst %,chr/bank%.bin,00 01 02 03 04 05 06 07 08 09 10 11 12 13 14 15)

.PHONY: all verify clean banks tools

INCLUDES := prg/bank00.asm prg/bank01.asm prg/bank02.asm prg/bank03.asm prg/bank04.asm prg/bank05.asm prg/bank06.asm prg/bank07.asm

all: $(OUT)

$(OUT): $(SRC) $(CFG) $(INCLUDES) $(PRG_BINS) $(CHR_BINS)
	mkdir -p generated
	$(CA65) -o generated/NinjaGaiden.o $(SRC)
	$(LD65) -C $(CFG) -o $(OUT) generated/NinjaGaiden.o

verify: all
	@$(SHA1SUM) -c $(SHA1FILE)

banks: $(ROM) tools/split-rom.py
	python3 tools/split-rom.py $(ROM)

tools:
	tools/install-cc65

clean:
	rm -f $(OUT)
	rm -rf generated
