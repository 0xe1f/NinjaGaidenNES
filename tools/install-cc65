# Clone, build, and install ca65/ld65 into this repo's tools/ (gitignored).
# Pin matches CI: cc65 V2.19. Only the bin target is built.
#
#   install-cc65         # skip if tools/ca65 and tools/ld65 already exist
#   install-cc65 --force

set -euo pipefail
TAG="${CC65_TAG:-V2.19}"
SRC_URL="https://github.com/cc65/cc65.git"
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --force|-f) force=1; shift ;;
    *) echo "usage: install-cc65 [--force]" >&2; exit 2 ;;
  esac
done

root="$(cd "$(dirname "$0")/.." && pwd)"
ca65="$root/tools/ca65"
ld65="$root/tools/ld65"
if [ "$force" -eq 0 ] && [ -x "$ca65" ] && [ -x "$ld65" ]; then
  echo "already installed: $ca65"
  exit 0
fi

command -v git >/dev/null && command -v make >/dev/null && command -v cc >/dev/null || {
  echo "install-cc65: need git, make, and a C compiler" >&2
  exit 1
}

tmp="$(mktemp -d "${TMPDIR:-/tmp}/cc65.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
git clone --depth 1 --branch "$TAG" "$SRC_URL" "$tmp/src"
make -C "$tmp/src" bin
cp "$tmp/src/bin/ca65" "$ca65"
cp "$tmp/src/bin/ld65" "$ld65"
chmod +x "$ca65" "$ld65"
echo "installed $ca65 ($("$ca65" --version 2>&1 | head -1))"
